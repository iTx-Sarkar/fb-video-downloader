<!DOCTYPE html><html><head><title>Team Bandaheali | Facebook Video Downloader</title><link href='https://cdn.tailwindcss.com' rel='stylesheet'><style>.glass { background: rgba(255,255,255,0.1); backdrop-filter: blur(10px); }</style></head><body class='bg-slate-900 text-white p-6'><div class='max-w-2xl mx-auto glass p-8 rounded-2xl'><h1 class='text-3xl font-bold mb-4'>Team Bandaheali FB Downloader</h1><form action='/download' method='POST'><input name='url' placeholder='Paste FB Video Link...' class='w-full p-3 rounded bg-slate-800 border mb-4' required><button class='w-full bg-blue-600 p-3 rounded font-bold'>Get Links</button></form><% if(results) { results.forEach(item => { if(item.url !== '/') { %><div class='mt-4 p-4 border rounded flex justify-between'><span><%= item.quality %></span><a href='<%= item.url %>' download class='bg-green-600 px-4 py-2 rounded'>Download</a></div><% } }) } %></div></body></html>